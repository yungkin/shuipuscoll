# ============================================================
#  只发布 docs/，以下源文件不提交（防止文章原文与配置被下载）
#  注意：规则用 "/" 开头锚定到仓库根目录，
#        否则 static/ 会连发布目录里的 docs/static/ 一起忽略，
#        导致线上站点丢失 CSS / JS。
# ============================================================

# 文章 Markdown 源文件（正文原文）
/md/

# 站点与文章配置（含文章目录、标题、日期等元信息）
/config.json
/config.pk

# 生成器与模板
/build.py
/templates/

# 静态资源源目录（构建时会整体复制进 docs/static/）
/static/

# ============================================================
#  其余忽略项
# ============================================================

# 系统
.DS_Store
Thumbs.db
desktop.ini

# 编辑器
.idea/
.vscode/
*.swp

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
